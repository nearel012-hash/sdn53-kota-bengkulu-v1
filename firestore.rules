rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // School Identity - Publicly readable, writeable
    match /schoolIdentity/{document=**} {
      allow read, write: if true;
    }

    // Articles - Publicly readable, writeable
    match /articles/{document=**} {
      allow read, write: if true;
    }

    // Media - Publicly readable, writeable
    match /media/{document=**} {
      allow read, write: if true;
    }

    // Graduation Config & Students - Publicly readable, writeable
    match /graduationConfig/{document=**} {
      allow read, write: if true;
    }

    match /graduationStudents/{document=**} {
      allow read, write: if true;
    }

    // Comments & Other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
