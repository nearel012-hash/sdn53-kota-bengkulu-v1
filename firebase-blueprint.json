{
  "entities": {
    "schoolIdentity": {
      "title": "School Identity",
      "description": "School profile, branding, contacts, and appearance configuration",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "tagline": { "type": "string" },
        "portalTitle": { "type": "string" },
        "portalBadge": { "type": "string" },
        "npsn": { "type": "string" },
        "accreditation": { "type": "string" },
        "principalName": { "type": "string" },
        "principalNip": { "type": "string" },
        "principalPhotoUrl": { "type": "string" },
        "principalGreeting": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "socialMedia": { "type": "object" },
        "vision": { "type": "string" },
        "missions": { "type": "array" },
        "logo": { "type": "object" },
        "theme": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "articles": {
      "title": "News and Articles",
      "description": "School news, announcements, and publication articles",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "status": { "type": "string" },
        "category": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "featuredImageUrl": { "type": "string" },
        "featuredMediaId": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "publishedAt": { "type": "string" },
        "views": { "type": "number" },
        "attachedMediaIds": { "type": "array" }
      },
      "required": ["title", "slug", "status", "category", "content"]
    },
    "media": {
      "title": "Media Item",
      "description": "Universal media assets including images, documents, audio, and videos",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string" },
        "mimeType": { "type": "string" },
        "fileSize": { "type": "number" },
        "dataUrl": { "type": "string" },
        "category": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "downloadCount": { "type": "number" }
      },
      "required": ["title", "type", "mimeType"]
    },
    "graduationConfig": {
      "title": "Graduation Configuration",
      "description": "Graduation announcement release status and configuration",
      "type": "object",
      "properties": {
        "isPublished": { "type": "boolean" },
        "academicYear": { "type": "string" },
        "releaseDate": { "type": "string" },
        "announcementLetterNumber": { "type": "string" }
      }
    },
    "graduationStudents": {
      "title": "Graduation Student Record",
      "description": "Student graduation verification records and SKL status",
      "type": "object",
      "properties": {
        "nisn": { "type": "string" },
        "nis": { "type": "string" },
        "fullName": { "type": "string" },
        "className": { "type": "string" },
        "status": { "type": "string" },
        "averageScore": { "type": "number" }
      },
      "required": ["nisn", "fullName", "status"]
    }
  },
  "firestore": {
    "/schoolIdentity/{id}": {
      "schema": "schoolIdentity",
      "description": "Global school identity settings document"
    },
    "/articles/{articleId}": {
      "schema": "articles",
      "description": "Collection of school articles and news"
    },
    "/media/{mediaId}": {
      "schema": "media",
      "description": "Universal school media items and archives"
    },
    "/graduationConfig/{id}": {
      "schema": "graduationConfig",
      "description": "Graduation settings"
    },
    "/graduationStudents/{studentId}": {
      "schema": "graduationStudents",
      "description": "Graduation records per student"
    }
  }
}
